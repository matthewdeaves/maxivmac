# clang targeting mingw-w64, using the gcc-mingw runtime/libstdc++ from the image
set(GCCV 14-posix)
set(GCCD /usr/lib/gcc/x86_64-w64-mingw32/${GCCV})
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET x86_64-w64-mingw32)
set(CMAKE_CXX_COMPILER_TARGET x86_64-w64-mingw32)
set(CMAKE_RC_COMPILER x86_64-w64-mingw32-windres)
set(CMAKE_C_FLAGS_INIT "--sysroot=/usr/x86_64-w64-mingw32")
set(CMAKE_CXX_FLAGS_INIT "--sysroot=/usr/x86_64-w64-mingw32 -isystem ${GCCD}/include/c++ -isystem ${GCCD}/include/c++/x86_64-w64-mingw32")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -L${GCCD} -lwinpthread")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld -L${GCCD}")
set(CMAKE_FIND_ROOT_PATH /opt/sdl3-mingw /usr/x86_64-w64-mingw32)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
